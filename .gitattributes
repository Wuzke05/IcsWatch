# 仓库里统一 LF，工作区按平台原生；Windows 专用文件强制 CRLF
* text=auto

*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.cs     text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.manifest text eol=crlf

*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.exe binary
